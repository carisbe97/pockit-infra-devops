# ==============================================================================
# Pockit Finance - Plantilla Ambiente HERMES (QA / Staging en OCI)
# ==============================================================================
# Uso en servidor OCI:
#   cp .env.hermes.example .env.hermes
#   # Reemplazar todos los placeholders ENC(...) con valores cifrados por Jasypt
#   docker compose --env-file .env.hermes -f docker-compose.hermes.yml up -d --build
# ==============================================================================

SPRING_PROFILES_ACTIVE=hermes

# --- Jasypt Master Key (Inyectada en runtime; NUNCA versionar en Git) ---
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_HERMES_JASYPT_MASTER_KEY

# --- Base de Datos Supabase Cloud QA (Transaction Pooler :6543 / Direct :5432) ---
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
FLYWAY_DB_URL=jdbc:postgresql://db.YOUR_HERMES_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_HERMES_PROJECT_REF
DB_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_DB_PASSWORD)

# --- Seguridad JWT & Criptografia ---
JWT_SECRET=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_JWT_SECRET)
JWT_ISSUER=pockit-ms-auth-user
APP_CRYPTO_RSA_PRIVATE_KEY=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_RSA_PRIVATE_KEY)
APP_CRYPTO_RSA_PUBLIC_KEY=REPLACE_WITH_HERMES_RSA_PUBLIC_KEY_BASE64
APP_CORS_ALLOWED_ORIGINS=https://qa.pockitfinance.com

# --- Supabase Storage QA ---
SUPABASE_URL=https://YOUR_HERMES_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_SUPABASE_KEY)
SUPABASE_AVATAR_BUCKET=avatars

# --- Certificados mTLS PKCS12 (montados en ./certs/generated:/app/certs:ro) ---
SSL_KEYSTORE_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_MTLS_PASSWORD)
SSL_TRUSTSTORE_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_HERMES_MTLS_PASSWORD)
MTLS_HEALTHCHECK_PASSWORD=CHANGE_ME_HERMES_MTLS_RAW_PASSWORD

# --- Recursos JVM (OCI ARM64 / Free Tier) ---
MS_AUTH_JAVA_OPTS=-Xms192m -Xmx384m -XX:+UseG1GC
GATEWAY_JAVA_OPTS=-Xms128m -Xmx256m -XX:+UseG1GC
