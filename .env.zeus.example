# ==============================================================================
# Pockit Finance - Plantilla Ambiente ZEUS (Produccion en OCI)
# ==============================================================================
# Uso en servidor OCI:
#   cp .env.zeus.example .env.zeus
#   # Reemplazar todos los placeholders ENC(...) con valores cifrados por Jasypt
#   docker compose --env-file .env.zeus -f docker-compose.zeus.yml up -d --build
# ==============================================================================

SPRING_PROFILES_ACTIVE=zeus

# --- Jasypt Master Key (Inyectada en runtime; NUNCA versionar en Git) ---
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_ZEUS_JASYPT_MASTER_KEY

# --- Base de Datos Supabase Cloud PROD (Transaction Pooler :6543 / Direct :5432) ---
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
FLYWAY_DB_URL=jdbc:postgresql://db.YOUR_ZEUS_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_ZEUS_PROJECT_REF
DB_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_DB_PASSWORD)

# --- Seguridad JWT & Criptografia ---
JWT_SECRET=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_JWT_SECRET)
JWT_ISSUER=pockit-ms-auth-user
APP_CRYPTO_RSA_PRIVATE_KEY=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_RSA_PRIVATE_KEY)
APP_CRYPTO_RSA_PUBLIC_KEY=REPLACE_WITH_ZEUS_RSA_PUBLIC_KEY_BASE64
APP_CORS_ALLOWED_ORIGINS=https://app.pockitfinance.com

# --- Supabase Storage PROD ---
SUPABASE_URL=https://YOUR_ZEUS_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_SUPABASE_KEY)
SUPABASE_AVATAR_BUCKET=avatars

# --- Certificados mTLS PKCS12 (montados en ./certs/generated:/app/certs:ro) ---
SSL_KEYSTORE_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_MTLS_PASSWORD)
SSL_TRUSTSTORE_PASSWORD=ENC(REPLACE_WITH_JASYPT_ENCRYPTED_ZEUS_MTLS_PASSWORD)
MTLS_HEALTHCHECK_PASSWORD=CHANGE_ME_ZEUS_MTLS_RAW_PASSWORD

# --- Recursos JVM (OCI Produccion) ---
MS_AUTH_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
GATEWAY_JAVA_OPTS=-Xms192m -Xmx384m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
