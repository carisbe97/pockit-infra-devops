# ==============================================================================
# Pockit Finance - Plantilla Ambiente ARES (Desarrollo Local)
# ==============================================================================
# Uso:
#   cp .env.ares.example .env.ares
#   docker compose --env-file .env.ares --profile ares up -d --build
# ==============================================================================

SPRING_PROFILES_ACTIVE=ares

# --- Base de Datos PostgreSQL Local (pockit-ares-db) ---
ARES_DB_NAME=pockit-ares
ARES_DB_USER=pockit_admin
ARES_DB_PASSWORD=pockit_ares_dev_2026
ARES_DB_PORT=5432

# --- Puertos Locales ---
MS_AUTH_PORT=8081
GATEWAY_PORT=8080

# --- Jasypt & JWT (Solo valores de desarrollo local) ---
JASYPT_ENCRYPTOR_PASSWORD=pockit-ares-dev-jasypt-master-key
JWT_SECRET=pockit-ares-dev-jwt-secret-key-minimo-64-bytes-hs512-solo-desarrollo-local-0123456789
JWT_ISSUER=pockit-ms-auth-user

# --- CORS Local ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080

# --- Supabase Storage (Opcional en desarrollo local) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
