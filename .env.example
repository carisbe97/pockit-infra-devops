# ==============================================================================
# Pockit Finance - Plantilla General de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a .env (o usa las plantillas especificas .env.ares.example,
# .env.hermes.example, .env.zeus.example).
# NUNCA subas archivos .env reales con secretos a Git.
# ==============================================================================

# --- Perfil Spring Boot (ares | hermes | zeus) ---
SPRING_PROFILES_ACTIVE=ares

# --- Puertos locales (solo ambiente Ares) ---
ARES_DB_PORT=5432
MS_AUTH_PORT=8081
GATEWAY_PORT=8080

# --- Base de Datos PostgreSQL ---
ARES_DB_NAME=pockit-ares
ARES_DB_USER=pockit_admin
ARES_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_URL=jdbc:postgresql://pockit-ares-db:5432/pockit-ares
DB_USERNAME=pockit_admin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
FLYWAY_DB_URL=jdbc:postgresql://pockit-ares-db:5432/pockit-ares

# --- Jasypt (Llave Maestra de Cifrado PBEWITHHMACSHA512ANDAES_256) ---
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_JASYPT_MASTER_KEY

# --- Seguridad JWT & Criptografia ---
JWT_SECRET=CHANGE_ME_MIN_64_BYTES_HS512_SECRET_KEY
JWT_ISSUER=pockit-ms-auth-user
APP_CRYPTO_RSA_PRIVATE_KEY=
APP_CRYPTO_RSA_PUBLIC_KEY=
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- Supabase Storage (Avatares) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_AVATAR_BUCKET=avatars

# --- Certificados mTLS (Hermes / Zeus) ---
MTLS_STORE_PASSWORD=CHANGE_ME_MTLS_STORE_PASSWORD
MTLS_VALIDITY_DAYS=365
SSL_KEYSTORE_PASSWORD=CHANGE_ME_MTLS_STORE_PASSWORD
SSL_TRUSTSTORE_PASSWORD=CHANGE_ME_MTLS_STORE_PASSWORD
